---
interface Props {
  label: string;
  ariaLabel: string;
  orientatie?: 'landscape' | 'portrait' | 'wide' | 'square';
  meta: string;
  tag?: string;
}

const { label, ariaLabel, orientatie = 'landscape', meta, tag = 'Foto volgt' } = Astro.props;
---

<figure class={`ph ph--${orientatie}`} role="img" aria-label={ariaLabel}>
  <span class="ph__tag">{tag}</span>
  <span class="ph__label">{label}</span>
  <span class="ph__meta">{meta}</span>
</figure>
