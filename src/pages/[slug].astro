---
import type { ImageMetadata, InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Checklist from '../components/Checklist.astro';
import CtaBlok from '../components/CtaBlok.astro';
import FotoPlaceholder from '../components/FotoPlaceholder.astro';
import PageHeader from '../components/PageHeader.astro';
import Stappen from '../components/Stappen.astro';
import demontageWerkplaats from '../assets/demontage-werkplaats.jpeg';
import onderdelenLoods from '../assets/onderdelen-loods.jpeg';
import ophaalwagen from '../assets/ophaalwagen.jpeg';

export async function getStaticPaths() {
  const diensten = await getCollection('diensten');
  return diensten.map((dienst) => ({
    params: { slug: dienst.id },
    props: { dienst },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

// Real photos per dienst; a dienst without an entry falls back to the placeholder.
const dienstFotos: Record<string, ImageMetadata> = {
  'gebruikte-onderdelen': onderdelenLoods,
  'auto-verkopen': ophaalwagen,
  demontage: demontageWerkplaats,
};

const { dienst } = Astro.props;
const { Content } = await render(dienst);
const heeftTekst = (dienst.body ?? '').trim().length > 0;
const huidigPad = `/${dienst.id}/`;
const dienstFoto = dienstFotos[dienst.id];
---

<Basis
  titel={dienst.data.paginaTitel}
  omschrijving={dienst.data.metaOmschrijving}
  huidigPad={huidigPad}
>
  <PageHeader breadcrumbLabel={dienst.data.titel} titel={dienst.data.kop} intro={dienst.data.intro} />

  <Stappen
    eyebrow={dienst.data.stappen.eyebrow}
    titel={dienst.data.stappen.titel}
    stappen={dienst.data.stappen.items}
  />

  <section class="section section--alt" aria-labelledby="praktisch-titel">
    <div class="wrap split">
      <div class="split__body">
        <p class="eyebrow">{dienst.data.praktisch.eyebrow}</p>
        <h2 class="section__title" id="praktisch-titel">{dienst.data.praktisch.titel}</h2>
        {
          dienst.data.praktisch.lead && (
            <p class="lead" style="margin-bottom: var(--space-5);">
              {dienst.data.praktisch.lead}
            </p>
          )
        }
        {heeftTekst && <Content />}
        {dienst.data.praktisch.items && <Checklist items={dienst.data.praktisch.items} />}
      </div>
      <div class="split__media">
        {
          dienstFoto ? (
            <Image
              src={dienstFoto}
              alt={dienst.data.foto.ariaLabel}
              class={`foto foto--${dienst.data.foto.orientatie}`}
              widths={[480, 760, 1040]}
              sizes="(min-width: 880px) 520px, 100vw"
            />
          ) : (
            <FotoPlaceholder {...dienst.data.foto} />
          )
        }
      </div>
    </div>
  </section>

  <CtaBlok eyebrow={dienst.data.cta.eyebrow} titel={dienst.data.cta.titel} />
</Basis>
